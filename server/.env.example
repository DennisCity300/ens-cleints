PORT=4310

# App login (single shared account used to unlock the app)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Random 32-byte hex key used to encrypt stored credentials at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "true" ONLY once this server is actually reachable over HTTPS
# (directly or behind a TLS-terminating reverse proxy like nginx/Caddy).
# Leave unset/false for local use (http://localhost) — a Secure cookie is
# silently dropped over plain HTTP and login will appear to succeed but not
# actually persist.
COOKIE_SECURE=false
